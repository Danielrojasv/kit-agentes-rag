# Copiar a .env y completar. NUNCA commitear el .env real.
POSTGRES_USER=kit
POSTGRES_PASSWORD=
# openssl rand -hex 32 para cada uno
NEXTAUTH_SECRET=
LANGFUSE_SALT=
# Claves de modelos (opcionales; sin ellas el kit corre en modo degradado)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Gateway OpenAI-compatible (vLLM, Ollama, LiteLLM, gateway corporativo...).
# Si el servidor sirve bajo /v1, incluirlo en la base URL. Con base URL
# definida, estos modelos van PRIMERO en la cadena de proveedores.
# OPENAI_COMPAT_MODELOS admite varios separados por coma (respaldo en orden).
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELOS=
# Puerto de la API (default 8000)
PORT=8000
# Motor RAG: nucleo (default) | langchain (enchufe futuro, degrada al nucleo)
MOTOR_RAG=nucleo
